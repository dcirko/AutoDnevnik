{
    "name": "dcirko/autodnevnik",
    "description": "AutoDnevnik - evidencija vozila i odrzavanja",
    "type": "project",
    "require": {
        "php": "~8.4.0",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "autoload": {
        "psr-4": {
            "AutoDnevnik\\": "src/"
        }
    },
    "scripts": {
        "db:install": "php bin/database-install.php",
        "db:seed": "php bin/database-seed.php",
        "test": ["php tests/database.php", "php tests/http.php"]
    }
}
