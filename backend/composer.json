{
    "name": "dcirko/autodnevnik",
    "description": "AutoDnevnik - evidencija vozila i odrzavanja",
    "type": "project",
    "require": {
        "php": "~8.4.0",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-curl": "*",
        "ext-json": "*",
        "laravel/framework": "^13.17"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "scripts": {
        "db:install": "@php artisan migrate --no-interaction",
        "db:seed": "@php artisan db:seed --no-interaction",
        "lint": "@php bin/lint.php",
        "format": "php-cs-fixer fix",
        "format:check": "php-cs-fixer fix --dry-run --diff",
        "test": ["@php vendor/bin/phpunit", "@php tests/database.php", "@php tests/http.php"],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "require-dev": {
        "php-cs-fixer/shim": "^3.95",
        "phpunit/phpunit": "^12.5"
    },
    "autoload-dev": {
        "psr-4": {"Tests\\": "tests/"}
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
