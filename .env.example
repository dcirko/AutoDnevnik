# Copy to .env and choose separate local passwords before first startup.
APP_ENV=local
APP_PORT=8080
APP_URL=http://localhost:8080

# Within Docker, the database hostname is the Compose service name.
DB_HOST=db
DB_PORT=3306
DB_DATABASE=autodnevnik
DB_USERNAME=autodnevnik
DB_PASSWORD=replace-with-local-database-password
MYSQL_ROOT_PASSWORD=replace-with-different-local-root-password

# Public service; no API key required. Integration is planned for phase 6.
VIN_API_BASE_URL=https://vpic.nhtsa.dot.gov/api
VIN_API_TIMEOUT_SECONDS=10
